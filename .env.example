# Copy this file to `.env` and fill in your key.
# `.env` is git-ignored so your real key is never committed.
#
# Used by the AI comparison feature (build step 6). Until then the app runs in
# mock/offline mode and does not need a key.
#
# NOTE: EXPO_PUBLIC_* variables are embedded in the JS bundle and readable on the
# device. This direct-from-client usage is for local testing only — a production
# app must proxy Anthropic calls through a backend so the key never ships to the
# client. You can also paste your key at runtime via the in-app Settings screen.
EXPO_PUBLIC_ANTHROPIC_API_KEY=
